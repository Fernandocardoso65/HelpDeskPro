@page
@model HelpDeskWeb.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center"
         style="min-height: 70vh;">

        <div class="col-lg-5 col-md-7">

            <div class="card shadow border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <span class="badge bg-primary mb-3">
                            HelpDesk Pro
                        </span>

                        <h1 class="h3 fw-bold">
                            Acesse sua central
                        </h1>

                        <p class="text-muted">
                            Entre para acompanhar e gerenciar seus chamados.
                        </p>

                    </div>

                    <form method="post"
                          asp-route-returnUrl="@Model.ReturnUrl">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="form-floating mb-3">

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="nome@empresa.com" />

                            <label asp-for="Input.Email">
                                E-mail
                            </label>

                            <span asp-validation-for="Input.Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-floating mb-3">

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Senha" />

                            <label asp-for="Input.Password">
                                Senha
                            </label>

                            <span asp-validation-for="Input.Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                   class="form-check-label">
                                Manter conectado
                            </label>

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100">
                            Entrar
                        </button>

                    </form>

                </div>

            </div>

            <div class="text-center mt-4">

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-area=""
                   class="text-decoration-none text-muted">

                    ← Voltar para o HelpDesk Pro

                </a>

            </div>

        </div>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
