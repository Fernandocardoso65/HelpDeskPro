@model HelpDeskWeb.Models.Chamado
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Atribuir Chamado";
    var tecnicos = ViewBag.Tecnicos as IList<IdentityUser>;
}

<h1>Atribuir Chamado</h1>

<div class="card shadow-sm">
    <div class="card-body">

        <h4>@Model.Titulo</h4>

        <p>
            <strong>Chamado:</strong> #@Model.Id
        </p>

        <p>
            <strong>Aberto por:</strong>
            @Model.UsuarioEmail
        </p>

        <p>
            <strong>Status atual:</strong>
            @Model.Status
        </p>

        <p>
            <strong>Prioridade:</strong>
            @Model.Prioridade
        </p>

        <hr />

        <form asp-action="Atribuir" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label">
                    Técnico responsável
                </label>

                <select name="tecnicoId"
                        class="form-select"
                        required>

                    <option value="">
                        Selecione um técnico
                    </option>

                    @if (tecnicos != null)
                    {
                        foreach (var tecnico in tecnicos)
                        {
                            <option value="@tecnico.Id">
                                @tecnico.Email
                            </option>
                        }
                    }

                </select>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Atribuir chamado
            </button>

            <a asp-action="Detalhes"
               asp-route-id="@Model.Id"
               class="btn btn-secondary">
                Cancelar
            </a>

        </form>

    </div>
</div>
