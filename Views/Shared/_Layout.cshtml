@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HelpDesk Pro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

<div class="app-wrapper">

    <aside id="sidebar" class="sidebar bg-dark text-white">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="m-0">
                HelpDesk Pro
            </h3>

            <button
                type="button"
                class="btn-close btn-close-white d-md-none"
                id="closeSidebar"
                aria-label="Fechar menu">
            </button>
        </div>

        <hr />

        <ul class="nav flex-column">

            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Chamados"
                       asp-action="Index">
                        Dashboard
                    </a>
                </li>

                @if (User.IsInRole("Usuario") ||
                     User.IsInRole("Administrador"))
                {
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Chamados"
                           asp-action="Criar">
                            Novo Chamado
                        </a>
                    </li>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Admin"
                           asp-action="Index">
                            Painel Administrativo
                        </a>
                    </li>
                }
            }

        </ul>

        <div class="sidebar-footer">
            <small>
                HelpDesk Pro v1.0
            </small>
        </div>

    </aside>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="main-wrapper">

        <nav class="navbar navbar-light bg-light shadow-sm px-3 px-md-4">

            <div class="d-flex align-items-center gap-2">

                <button
                    type="button"
                    id="openSidebar"
                    class="btn btn-outline-dark d-md-none">
                    ☰
                </button>

                <span class="navbar-brand mb-0 h1">
                    Sistema de Atendimento de TI
                </span>

            </div>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="user-area">

                    <span class="user-email">
                        @User.Identity?.Name
                    </span>

                    @if (User.IsInRole("Administrador"))
                    {
                        <span class="badge bg-danger">
                            Administrador
                        </span>
                    }
                    else if (User.IsInRole("Tecnico"))
                    {
                        <span class="badge bg-warning text-dark">
                            Técnico
                        </span>
                    }
                    else if (User.IsInRole("Usuario"))
                    {
                        <span class="badge bg-primary">
                            Usuário
                        </span>
                    }

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post">

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            Sair
                        </button>

                    </form>

                </div>
            }
            else
            {
                <div>
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-outline-primary btn-sm">
                        Entrar
                    </a>
                </div>
            }

        </nav>

        <main class="container-fluid main-content">

            @RenderBody()

        </main>

    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    const sidebar = document.getElementById("sidebar");
    const overlay = document.getElementById("sidebarOverlay");
    const openSidebar = document.getElementById("openSidebar");
    const closeSidebar = document.getElementById("closeSidebar");

    function abrirMenu() {
        sidebar.classList.add("sidebar-open");
        overlay.classList.add("sidebar-overlay-open");
    }

    function fecharMenu() {
        sidebar.classList.remove("sidebar-open");
        overlay.classList.remove("sidebar-overlay-open");
    }

    if (openSidebar) {
        openSidebar.addEventListener("click", abrirMenu);
    }

    if (closeSidebar) {
        closeSidebar.addEventListener("click", fecharMenu);
    }

    if (overlay) {
        overlay.addEventListener("click", fecharMenu);
    }
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
