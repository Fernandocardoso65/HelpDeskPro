@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HelpDesk Pro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

<div class="d-flex">

    <div class="bg-dark text-white p-3 vh-100"
         style="width: 240px; position: fixed;">

        <h3 class="mb-4">
            HelpDesk Pro
        </h3>

        <hr />

        <ul class="nav flex-column">

            @if (SignInManager.IsSignedIn(User))
            {
                <li class="nav-item mb-2">
                    <a class="nav-link text-white"
                       asp-controller="Chamados"
                       asp-action="Index">
                        Dashboard
                    </a>
                </li>

                @if (User.IsInRole("Usuario") ||
                     User.IsInRole("Administrador"))
                {
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Chamados"
                           asp-action="Criar">
                            Novo Chamado
                        </a>
                    </li>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <li class="nav-item mb-2">
                        <a class="nav-link text-white"
                           asp-controller="Admin"
                           asp-action="Index">
                            Painel Administrativo
                        </a>
                    </li>
                }
            }

        </ul>

        <div style="position:absolute; bottom:20px;">
            <small>
                HelpDesk Pro v1.0
            </small>
        </div>

    </div>


    <div style="margin-left:240px; width:100%;">

        <nav class="navbar navbar-light bg-light shadow-sm px-4">

            <span class="navbar-brand mb-0 h1">
                Sistema de Atendimento de TI
            </span>

            @if (SignInManager.IsSignedIn(User))
            {
                <div class="d-flex align-items-center gap-3">

                    <span>
                        @User.Identity?.Name
                    </span>

                    @if (User.IsInRole("Administrador"))
                    {
                        <span class="badge bg-danger">
                            Administrador
                        </span>
                    }
                    else if (User.IsInRole("Tecnico"))
                    {
                        <span class="badge bg-warning text-dark">
                            Técnico
                        </span>
                    }
                    else if (User.IsInRole("Usuario"))
                    {
                        <span class="badge bg-primary">
                            Usuário
                        </span>
                    }

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          method="post">

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            Sair
                        </button>

                    </form>

                </div>
            }
            else
            {
                <div>
                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-outline-primary btn-sm">
                        Entrar
                    </a>
                </div>
            }

        </nav>

        <main class="container-fluid p-4">

            @RenderBody()

        </main>

    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
